#!/bin/bash

output=$(dnf check-update --quiet 2>/dev/null)
result=$?

if [ $result -eq 100 ]; then
    count=$(echo "$output" | wc -l)
    
    notify-send -u normal \
        --icon=update-notifier \
        "Mises à jour disponibles" \
        "$count paquets à mettre à jour"

    echo "{\"text\": \"MàJ\", \"alt\": \"update\", \"tooltip\": \"$count mises à jour disponibles\"}"

elif [ $result -eq 0 ]; then
    echo "{\"text\": \"À jour\", \"alt\": \"ok\", \"tooltip\": \"Système à jour\"}"

else
    echo "{\"text\": \"Err\", \"alt\": \"error\", \"tooltip\": \"Erreur de vérification DNF\"}"
fi   
