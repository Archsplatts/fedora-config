set -euo pipefail

VERT='\033[0;32m'
JAUNE='\033[1;33m'
NC='\033[0m'

echo -e "${VERT}                                   ▄▄                    ${NC}"
echo -e "${VERT}                  █▄                ██       █▄  █▄      ${NC}"
echo -e "${VERT}       ▄          ██                ██      ▄██▄▄██▄     ${NC}"
echo -e "${VERT} ▄▀▀█▄ ████▄▄███▀ ████▄ ▄██▀█ ████▄ ██ ▄▀▀█▄ ██  ██ ▄██▀█${NC}"
echo -e "${VERT} ▄█▀██ ██   ██    ██ ██ ▀███▄ ██ ██ ██ ▄█▀██ ██  ██ ▀███▄${NC}"
echo -e "${VERT}▄▀█▄██▄█▀  ▄▀███▄▄██ ███▄▄██▀▄████▀▄██▄▀█▄██▄██ ▄███▄▄██▀${NC}"
echo -e "${VERT}                              ██                         ${NC}"
echo -e "${VERT}                              ▀                          ${NC}"

echo -e "${JAUNE}Bienvenue dans le script de configuration Archsplatts pour Fedora !${NC}\n"

if [ -t 0 ]; then
    read -p "Appuyez sur Entrée pour continuer... "
fi   

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[1/10] Mise à jour de Fedora${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

sudo dnf upgrade --refresh -y

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[2/10] Activation du dépôt RPM Fusion${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

sudo dnf install -y \
  https://mirrors.rpmfusion.org/free/fedora/rpmfusion-free-release-$(rpm -E %fedora).noarch.rpm \
  https://mirrors.rpmfusion.org/nonfree/fedora/rpmfusion-nonfree-release-$(rpm -E %fedora).noarch.rpm

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[3/10] Installation des pilotes & codecs${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

sudo dnf swap ffmpeg-free ffmpeg --allowerasing
sudo dnf install -y mesa-va-drivers-freeworld mesa-va-drivers-freeworld.i686

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[4/10] Activation du dépôt terra${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

sudo dnf install --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[5/10] Installation des paquets terra${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

PAQUETS_TERRA=(
	"lact" 
	"mangowm"
	"nwg-look"
	"starship"
	"ubuntu-nerd-fonts"
	"ubuntumono-nerd-fonts"
	"yazi"
)

sudo dnf install -y "${PAQUETS_TERRA[@]}"

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[6/10] Installation des utilitaires${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

PAQUETS_UTILS=(
	"bat"
	"btop"
	"calcurse"
	"cliphist"
	"discord"
	"eza"
	"fastfetch"
	"ffmpegthumbnailer"
	"firefox"
	"flameshot"
	"foot"
	"galculator"
	"gamemode"
	"gammastep"
	"geany"
	"grim"
	"helvum"
	"java-25-openjdk"
	"kernel-modules-extra"
	"lollypop"	
	"mako"
	"mangohud"
	"micro"
	"mpv"
	"papirus-icon-theme"
	"pavucontrol"
	"qbittorrent"
	"rhythmbox"
	"ristretto"
	"rofi"
	"sddm"
	"slurp"
	"swaybg"
	"swaylock"
	"steam"
	"thunar"
	"thunar-archive-plugin"
	"thunar-volman"
	"thunderbird"
	"trash-cli"
	"waybar"
	"wl-clipboard"
	"wmenu"
	"webkit2gtk4.1-devel"
	"xdg-desktop-portal-gtk" 
	"xdg-desktop-portal-wlr" 
	"xfce-polkit"
	"zathura"
	"zathura-pdf-mupdf"
	"zsh"
	"zsh-autosuggestions"
	"zsh-syntax-highlighting"
	"zoxide"
)

sudo dnf install -y "${PAQUETS_UTILS[@]}"

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[7/10] Configuration du shell Zsh${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

chsh -s /bin/zsh 

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[8/10] Copie des dotfiles${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

mkdir -p ~/.config
mkdir -p ~/.scripts
cd ~/fedora-config
cp -r config/* ~/.config
cp -r appearance/* ~/.scripts
cp zshrc ~/.zshrc
chmod u+x ~/.scripts/papirus-folders
chmod u+x ~/.config/mango/autostart

echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${JAUNE}[9/10] Catppuccin papirus folders${NC}"
echo -e "${JAUNE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"

git clone https://github.com/catppuccin/papirus-folders.git
cd papirus-folders
sudo cp -r src/* /usr/share/icons/Papirus
~/.scripts/papirus-folders -C cat-mocha-blue

